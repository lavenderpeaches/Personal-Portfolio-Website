---
// src/components/TechStack.astro
const skillCategories = [
  {
    category: "Languages",
    skills: ["Python", "C/C++", "JavaScript", "HTML/CSS"], //[cite: 1]
  },
  {
    category: "Frameworks & Web",
    skills: ["Django", "Django REST Framework", "FastAPI", "Flask", "React.js", "Nginx"], //[cite: 1]
  },
  {
    category: "Databases & DevOps",
    skills: ["PostgreSQL", "MinIO", "Docker", "Linux", "Git/GitHub/GitLab", "Keycloak"], //[cite: 1]
  },
  {
    category: "Tools & Async",
    skills: ["Celery", "RabbitMQ", "Postman"], //[cite: 1]
  },
];
---

<div class="techCard">
  <div class="card-header">
    <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="16 18 22 12 16 6"/>
      <polyline points="8 6 2 12 8 18"/>
    </svg>
    <span class="header-title">Tech Stack</span>
  </div>

  <div class="categoriesGrid">
    {skillCategories.map((group) => (
      <div class="group">
        <h4 class="category-title">{group.category}</h4>
        <div class="badges">
          {group.skills.map((skill) => (
            <span class="badge">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .techCard {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem 2rem;
    background: linear-gradient(135deg, rgba(30, 20, 45, 0.65), rgba(15, 15, 20, 0.85));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 24px;
    color: var(--text, #ffffff);
    height: 100%;
    box-sizing: border-box;
    transition: border-color 0.3s ease, background 0.2s ease;
  }

  .techCard:hover {
    border-color: rgba(168, 85, 247, 0.4);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #c084fc;
  }

  .header-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .header-title {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .categoriesGrid {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .category-title {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: #60a5fa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background: rgba(192, 132, 252, 0.12);
    color: #c084fc;
    border: 1px solid rgba(192, 132, 252, 0.3);
    padding: 0.18rem 0.55rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .badge:hover {
    background: rgba(192, 132, 252, 0.25);
    border-color: rgba(168, 85, 247, 0.5);
    color: #ffffff;
  }
</style>