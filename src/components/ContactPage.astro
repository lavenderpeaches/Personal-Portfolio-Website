---
// src/components/ContactPage.astro
---

<footer class="contactCard">
  <div class="info">
    <div class="card-header">
      <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="header-title">Contact Me</span>
    </div>

    <p class="text">
      Got an idea, a project, or just want to say hi? My inbox is open.
    </p>
  </div>

  <nav class="links" aria-label="Contact links">
    <a class="link" href="mailto:deepalix7@gmail.com">
      <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <span>deepalix7@gmail.com</span>
    </a>

    <a class="link" href="https://www.linkedin.com/in/deepali-b27a9a263/" target="_blank" rel="noopener noreferrer">
      <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
        <rect x="2" y="9" width="4" height="12"/>
        <circle cx="4" cy="4" r="2"/>
      </svg>
      <span>LinkedIn</span>
    </a>

    <a class="link" href="https://github.com/lavenderpeaches" target="_blank" rel="noopener noreferrer">
      <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
        <path d="M9 18c-4.51 2-5-2-7-2"/>
      </svg>
      <span>GitHub</span>
    </a>
  </nav>
</footer>

<style>
  .contactCard {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, rgba(30, 20, 45, 0.65), rgba(15, 15, 20, 0.85));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 24px;
    color: var(--text, #ffffff);
    box-sizing: border-box;
    transition: border-color 0.3s ease;
  }

  .contactCard:hover {
    border-color: rgba(168, 85, 247, 0.4);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #c084fc;
  }

  .header-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .header-title {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #e2e8f0;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #d8b4fe;
    text-decoration: none;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 999px;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .link:hover,
  .link:focus-visible {
    background: rgba(168, 85, 247, 0.25);
    border-color: rgba(168, 85, 247, 0.55);
    transform: translateY(-2px);
    outline: none;
  }

  .link-icon {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 968px) {
    .contactCard {
      flex-direction: column;
      align-items: flex-start;
    }

    .links {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link {
      transition: none;
    }

    .link:hover,
    .link:focus-visible {
      transform: none;
    }
  }
</style>
