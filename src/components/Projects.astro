---
// src/components/ProjectsSection.astro
const projects = [
  {
    title: "ZipLink",
    description: "Full-stack URL shortening service built with Base62 encoding, dynamic QR code generation, and secure user authentication.",
    tags: ["Python", "Django", "HTML/CSS", "Postman API", "Git"],
    github: "https://github.com/lavenderpeaches/ZipLink",
  },
  {
    title: "UniTest",
    description: "Academic testing platform for faculty and students featuring dynamic MCQ generation, real-time timers, and batch management.",
    tags: ["Python", "Django", "JavaScript", "HTML/CSS"],
    github: "https://github.com/lavenderpeaches/UniTest",
  },
];
---

<div class="projectsCard">
  <div class="card-header">
    <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
    </svg>
    <span class="header-title">Projects</span>
  </div>

  <div class="projectsRow">
    {projects.map((project) => (
      <div class="projectItem">
        <div class="project-header">
          <h3 class="title">{project.title}</h3>
          <a 
            href={project.github} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="github-link"
            aria-label={`View ${project.title} on GitHub`}
          >
            <svg class="github-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
        </div>

        <p class="description">{project.description}</p>

        <div class="tags">
          {project.tags.map((tag) => (
            <span class="badge">{tag}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .projectsCard {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem 2rem;
    background: linear-gradient(135deg, rgba(30, 20, 45, 0.65), rgba(15, 15, 20, 0.85));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 24px;
    color: var(--text, #ffffff);
    height: 100%;
    box-sizing: border-box;
    transition: border-color 0.3s ease, background 0.2s ease;
  }

  .projectsCard:hover {
    border-color: rgba(168, 85, 247, 0.4);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #c084fc;
  }

  .header-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .header-title {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Forced flex row layout */
  .projectsRow {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    width: 100%;
    height: 100%;
  }

  .projectItem {
    flex: 1 1 0;
    min-width: 0; /* Prevents overflow from forcing flex wrapping */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .projectItem:not(:last-child) {
    border-right: 1px solid rgba(168, 85, 247, 0.15);
    padding-right: 1.5rem;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .github-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c084fc;
    padding: 0.4rem;
    border-radius: 50%;
    background: rgba(192, 132, 252, 0.08);
    border: 1px solid rgba(192, 132, 252, 0.2);
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .github-link:hover {
    color: #ffffff;
    background: rgba(192, 132, 252, 0.25);
    border-color: rgba(168, 85, 247, 0.5);
    transform: scale(1.08);
  }

  .github-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #e2e8f0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background: rgba(192, 132, 252, 0.12);
    color: #c084fc;
    border: 1px solid rgba(192, 132, 252, 0.3);
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .projectsRow {
      flex-direction: column;
    }

    .projectItem:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid rgba(168, 85, 247, 0.15);
      padding-right: 0;
      padding-bottom: 1.5rem;
    }
  }
</style>