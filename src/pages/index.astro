---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import AboutSection from '../components/About.astro';
import ThemeToggle from '../components/ToggleTheme.astro';
import WorkExp from '../components/WorkExp.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import CoolThing from '../components/CoolThing.astro';
import ContactPage from '../components/ContactPage.astro';
---

<BaseLayout title="Deepali | Portfolio">
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="#top" aria-label="Deepali home">
        <span class="brand-mark">d.</span><span>deepali<span class="brand-dot">.dev</span></span>
      </a>
      <div class="workspace-label">PORTFOLIO <span>⌄</span></div>
      <nav class="side-nav" aria-label="Portfolio sections">
        <a class="nav-link active" href="#about"><span class="nav-icon">⌘</span><code>/about</code></a>
        <a class="nav-link" href="#experience"><span class="nav-icon">◷</span><code>/experience</code></a>
        <a class="nav-link" href="#projects"><span class="nav-icon">◇</span><code>/projects</code></a>
        <a class="nav-link" href="#stack"><span class="nav-icon">&lt;/&gt;</span><code>/stack</code></a>
        <a class="nav-link" href="#contact"><span class="nav-icon">↗</span><code>/contact</code></a>
        <a class="nav-link" href="#settings"><span class="nav-icon">⚙</span><code>/settings</code></a>
      </nav>
      <div class="sidebar-bottom">
        <div class="kirby-card" aria-label="A little Kirby says hello">
          <div class="kirby-spark spark-one">✦</div><div class="kirby-spark spark-two">✧</div>
          <svg class="kirby" viewBox="0 0 180 160" role="img" aria-label="Cute pink Kirby resting on a fluffy cloud">
            <defs>
              <linearGradient id="kirby-body" x1="0" y1="0" x2="0.8" y2="1"><stop offset="0" stop-color="#ffb8cb"/><stop offset="1" stop-color="#ff8eae"/></linearGradient>
              <linearGradient id="kirby-cloud" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fffafd"/><stop offset="1" stop-color="#f7dce8"/></linearGradient>
              <linearGradient id="kirby-feet" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ed5d84"/><stop offset="1" stop-color="#c93162"/></linearGradient>
            </defs>
            <path d="M27 132c-12-1-18-10-14-20 3-8 12-12 21-9-1-12 12-20 23-15 5-13 22-16 31-6 8-11 25-10 31 2 11-8 27-3 29 9 14-4 25 6 21 17-2 8-9 12-18 12-9 10-22 13-34 8-10 7-24 7-34 0-14 7-29 4-36-4-8 7-21 9-31 6Z" fill="url(#kirby-cloud)" stroke="#d99aae" stroke-width="3.2" stroke-linejoin="round"/>
            <ellipse cx="43" cy="116" rx="7" ry="4" fill="#fff" opacity=".72"/><ellipse cx="135" cy="122" rx="8" ry="4" fill="#fff" opacity=".72"/><ellipse cx="83" cy="137" rx="10" ry="3" fill="#fff" opacity=".55"/>
            <ellipse cx="90" cy="73" rx="57" ry="52" fill="url(#kirby-body)" stroke="#b94d6a" stroke-width="3.5"/>
            <ellipse cx="35" cy="91" rx="13" ry="9" fill="#ffa0ba" stroke="#ca6680" stroke-width="2.5" transform="rotate(-24 35 91)"/>
            <ellipse cx="145" cy="91" rx="13" ry="9" fill="#ffa0ba" stroke="#ca6680" stroke-width="2.5" transform="rotate(24 145 91)"/>
            <ellipse cx="62" cy="117" rx="27" ry="18" fill="url(#kirby-feet)" stroke="#a93d5e" stroke-width="3.5" transform="rotate(8 62 117)"/>
            <ellipse cx="118" cy="117" rx="27" ry="18" fill="url(#kirby-feet)" stroke="#a93d5e" stroke-width="3.5" transform="rotate(-8 118 117)"/>
            <path d="M44 112c6-6 17-8 25-5" fill="none" stroke="#ff9aaf" stroke-width="4" stroke-linecap="round" opacity=".75"/>
            <path d="M111 107c8-3 19-1 25 5" fill="none" stroke="#ff9aaf" stroke-width="4" stroke-linecap="round" opacity=".75"/>
            <path d="M62 66q11-9 22-2" fill="none" stroke="#873d57" stroke-width="4" stroke-linecap="round"/>
            <path d="M96 64q11-7 22 2" fill="none" stroke="#873d57" stroke-width="4" stroke-linecap="round"/>
            <circle cx="57" cy="82" r="10" fill="#f47e9e" opacity=".62"/><circle cx="123" cy="82" r="10" fill="#f47e9e" opacity=".62"/>
            <path d="M84 76q6 8 13 0" fill="none" stroke="#873d57" stroke-width="3" stroke-linecap="round"/>
            <ellipse cx="75" cy="37" rx="18" ry="6" fill="#fff" opacity=".17" transform="rotate(-24 75 37)"/>
          </svg>
          <p><strong>Hi, I’m Kirby!</strong><br/>Here to make your visit sweeter ✨</p>
        </div>
        <div class="side-status"><span class="status-dot"></span> Open to opportunities</div>
      </div>
    </aside>

    <main class="main-panel" id="top">
      <header class="topbar">
        <div class="breadcrumbs"><span>portfolio</span><b>/</b><code id="current-route">about</code></div>
        <div class="top-actions"><span class="online"><i></i> Available for work</span></div>
      </header>
      <div class="page-container">
        <section class="page-section" id="about">
          <div class="section-heading"><div><span class="eyebrow">WELCOME TO MY LITTLE CORNER</span><h1>Hey there, I’m <em>Deepali</em> <span class="wave">✿</span></h1><p class="section-lead">A developer who likes making useful things (and occasionally breaking them first).</p></div><span class="route-pill">/about</span></div>
          <div class="row-one"><div class="profile"><ProfileCard /></div><div class="intro"><AboutSection /></div></div>
        </section>
        <section class="page-section" id="experience"><div class="section-heading compact"><div><span class="eyebrow">WHERE I’VE BEEN</span><h2>Experience</h2></div><span class="route-pill">/experience</span></div><WorkExp /></section>
        <section class="page-section" id="projects"><div class="section-heading compact"><div><span class="eyebrow">THINGS I’VE BUILT</span><h2>Selected projects</h2></div><span class="route-pill">/projects</span></div><Projects /></section>
        <section class="page-section" id="stack"><div class="section-heading compact"><div><span class="eyebrow">MY TOOLBOX</span><h2>Tech stack</h2></div><span class="route-pill">/stack</span></div><div class="row-three"><TechStack /><CoolThing /></div></section>
        <section class="page-section contact-section" id="contact"><div class="section-heading compact"><div><span class="eyebrow">LET’S MAKE SOMETHING</span><h2>Say hello</h2></div><span class="route-pill">/contact</span></div><ContactPage /></section>
        <section class="page-section settings-section" id="settings"><div class="section-heading compact"><div><span class="eyebrow">MAKE YOURSELF AT HOME</span><h2>Settings</h2></div><span class="route-pill">/settings</span></div><div class="settings-card"><div><strong>Appearance</strong><p>Choose a cozy color mode for your visit.</p></div><ThemeToggle /></div></section>
      </div>
      <footer class="app-footer"><span>Made with <span class="heart">♥</span> & a little stardust</span><span>© 2026 Deepali</span></footer>
    </main>
  </div>
  <script>
    const navLinks = [...document.querySelectorAll('.nav-link')];
    const routeLabel = document.getElementById('current-route');
    const sections = [...document.querySelectorAll('.page-section')];
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      const id = visible.target.id;
      const label = id === 'stack' ? 'stack' : id;
      if (routeLabel) routeLabel.textContent = label;
      navLinks.forEach((link) => link.classList.toggle('active', link.hash === '#' + id));
    }, { rootMargin: '-20% 0px -60% 0px', threshold: [0, .2, .5] });
    sections.forEach((section) => observer.observe(section));
  </script>
</BaseLayout>

<style is:global>
  :root { --bg:#fff7fa; --bg-card:#fff; --text:#3f3040; --text-muted:#8b7485; --accent:#e879a3; --pink:#ec79a1; --pink-deep:#c85580; --line:#f1dce5; --lav:#f4efff; }
  html.dark { --bg:#211923; --bg-card:#302331; --text:#fff1f7; --text-muted:#c4aeba; --line:#50384b; --lav:#382b43; }
  body { background:var(--bg); color:var(--text); font-family:Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif; }
  .app-shell { min-height:100vh; }
  .sidebar { position:fixed; inset:0 auto 0 0; width:250px; padding:25px 17px 17px; display:flex; flex-direction:column; background:#fffafd; border-right:1px solid var(--line); z-index:5; }
  html.dark .sidebar { background:#281f2a; }
  .brand { display:flex; align-items:center; gap:10px; padding:0 10px 28px; color:var(--text); text-decoration:none; font-size:17px; font-weight:750; letter-spacing:-.03em; }
  .brand-mark { width:31px; height:31px; display:grid; place-items:center; border-radius:11px; color:white; background:linear-gradient(140deg,#f29ab9,#d96f9c); font-size:18px; }
  .brand-dot { color:var(--pink); }
  .workspace-label { display:flex; justify-content:space-between; padding:0 10px 10px; font-size:10px; font-weight:800; letter-spacing:.14em; color:#b49eac; }
  .side-nav { display:grid; gap:4px; }
  .nav-link { display:flex; align-items:center; gap:11px; min-height:39px; padding:7px 10px; color:#897585; text-decoration:none; border-radius:9px; transition:background .18s,color .18s; }
  .nav-link:hover { background:#fff0f5; color:var(--pink-deep); }
  html.dark .nav-link:hover { background:#3c2a38; }
  .nav-link.active { color:var(--pink-deep); background:#ffedf3; box-shadow:inset 2px 0 #e879a3; }
  html.dark .nav-link.active { background:#482b3d; color:#ffb5ce; }
  .nav-link code,.breadcrumbs code,.route-pill { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; }
  .nav-icon { display:inline-grid; place-items:center; width:19px; color:#d895af; font-size:15px; }
  .sidebar-bottom { margin-top:auto; }
  .kirby-card { position:relative; overflow:hidden; padding:15px 10px 13px; margin:10px 3px 15px; border:1px solid #f4dbe5; border-radius:15px; text-align:center; background:linear-gradient(145deg,#fff1f6,#fff9fc); }
  html.dark .kirby-card { background:linear-gradient(145deg,#452d3c,#35263a); border-color:#5b4052; }
  .kirby { width:130px; height:118px; animation:kirby-bob 3.8s ease-in-out infinite; display:block; margin:0 auto -2px; filter:drop-shadow(0 6px 3px #e8a0b64a); }
  .kirby-card p { margin:0; font-size:11px; line-height:1.65; color:#9b7a8b; }
  .kirby-card strong { color:#b9567e; font-size:12px; }
  @keyframes kirby-bob { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-3px); } }
  .kirby-spark { position:absolute; color:#eaa4be; font-size:18px; }.spark-one{top:20px;left:17px}.spark-two{top:41px;right:17px}
  .side-status { display:flex; align-items:center; gap:8px; padding:10px; color:#967e8d; font-size:11px; }
  .status-dot,.online i { display:inline-block; width:7px; height:7px; border-radius:50%; background:#76c9a2; box-shadow:0 0 0 3px #76c9a21c; }
  .main-panel { margin-left:250px; min-height:100vh; }
  .topbar { height:61px; position:sticky; top:0; z-index:4; display:flex; align-items:center; justify-content:space-between; padding:0 38px; background:color-mix(in srgb,var(--bg) 88%,transparent); backdrop-filter:blur(12px); border-bottom:1px solid var(--line); }
  .breadcrumbs { display:flex; align-items:center; gap:10px; font-size:12px; color:#ac98a6; }.breadcrumbs b{font-weight:400;color:#d8c3cf}.breadcrumbs code{color:#b95f83}
  .top-actions { display:flex; align-items:center; gap:15px; }.online { display:flex; align-items:center; gap:8px; color:#8b7485; font-size:11px; }
  .page-container { display:flex; flex-direction:column; gap:34px; padding:39px clamp(22px,5vw,72px) 35px; max-width:1440px; margin:0 auto; }
  .page-section { scroll-margin-top:82px; }
  .section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:20px; }
  .section-heading.compact { align-items:center; margin-bottom:14px; }
  .eyebrow { display:block; margin-bottom:9px; color:#c685a0; font-size:9px; font-weight:800; letter-spacing:.16em; }
  h1,h2 { margin:0; color:var(--text); letter-spacing:-.04em; }
  h1 { font-size:clamp(28px,3vw,40px); line-height:1.15; } h1 em { color:#df7398; font-style:normal; }
  h2 { font-size:23px; }
  .wave { color:#e7a0b8; font-size:.8em; }
  .section-lead { margin:9px 0 0; color:var(--text-muted); font-size:13px; line-height:1.65; }
  .route-pill { padding:5px 9px; color:#b66e8b; border:1px solid #f0d6e1; background:#fffafd; border-radius:7px; white-space:nowrap; }
  html.dark .route-pill { background:#302331; border-color:#50384b; }
  .row-one { display:grid; grid-template-columns:minmax(250px,.8fr) minmax(0,1.5fr); gap:15px; }
  .row-three { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(260px,1fr); gap:15px; align-items:stretch; }
  .row-three > * { min-width:0; }
  .page-container .profileCard,.page-container .aboutCard,.page-container .experienceCard,.page-container .projectsCard,.page-container .techCard,.page-container .coolCard,.page-container .contactCard { height:100%; padding:21px; border:1px solid var(--line); border-radius:15px; color:var(--text); background:var(--bg-card); box-shadow:0 5px 18px #6c35530a; backdrop-filter:none; }
  .page-container .aboutCard { background:linear-gradient(135deg,#fff0f5,#fffafd); border-color:#f3d8e3; }
  html.dark .page-container .aboutCard { background:linear-gradient(135deg,#482c3d,#302331); border-color:#5b4052; }
  .page-container .profileCard { gap:18px; background:linear-gradient(145deg,#fff,#fff6fa); }
  html.dark .page-container .profileCard { background:var(--bg-card); }
  .page-container .profileCard .name,.page-container .role,.page-container .title,.page-container .name-text { color:#503b4b; }
  html.dark .page-container .profileCard .name,html.dark .page-container .role,html.dark .page-container .title,html.dark .page-container .name-text { color:#fff1f7; }
  .page-container .profileCard .avatar { border-color:#fff; }.page-container .profileCard .location { color:#725b6b; }
  .page-container .aboutCard p,.page-container .text,.page-container .description,.page-container .highlights li,.page-container .para { color:var(--text-muted); }
  .page-container .accent-text,.page-container .subtle-text { color:#b9567e; }
  .page-container .company,.page-container .card-header,.page-container .header-title { color:#c6658b; }
  .page-container .meta-item { color:#9e8796; }
  .page-container .badge { color:#b4567a; background:#fff0f5; border-color:#f2d6e1; }
  html.dark .page-container .badge { color:#ffc2d5; background:#482b3d; border-color:#624355; }
  .page-container .digits { color:#a74f73; background:#fff0f5; border-color:#f1d1df; box-shadow:none; }
  .page-container .label,.page-container .message { color:#9e8796; }.page-container .colon { color:#d87599; }
  .page-container .highlight { color:#b4567a; background:#ffedf3; }
  .page-container .disclaimer { border-color:var(--line); }
  .page-container .contactCard { flex-direction:row; }
  .page-container .link { color:#b4567a; background:#fff1f6; border-color:#f0d1df; }
  .page-container .link:hover { color:#9e3e66; background:#ffe5ef; }
  .page-container .row-two { display:grid; grid-template-columns:1fr 1fr; gap:15px; }
  .settings-card { display:flex; align-items:center; justify-content:space-between; gap:18px; padding:18px 21px; border:1px solid var(--line); border-radius:15px; background:var(--bg-card); box-shadow:0 5px 18px #6c35530a; }.settings-card strong{font-size:13px}.settings-card p{margin:5px 0 0;color:var(--text-muted);font-size:12px}
  .app-footer { display:flex; justify-content:space-between; padding:0 clamp(22px,5vw,72px) 22px; color:#ad98a6; font-size:10px; }.heart{color:#df7398}
  #theme-toggle { width:36px;height:36px; background:#fffafd; border-color:#f1d9e3; color:#bd6488; backdrop-filter:none; }
  html.dark #theme-toggle { background:#302331; }
  @media(max-width:1050px){.sidebar{width:210px}.main-panel{margin-left:210px}.row-three{grid-template-columns:minmax(0,1.45fr) minmax(230px,1fr)}}
  @media(max-width:720px){.sidebar{position:sticky;inset:0 0 auto;width:auto;height:auto;padding:12px 15px;border-right:0;border-bottom:1px solid var(--line)}.brand{padding:0 4px 10px}.workspace-label,.sidebar-bottom{display:none}.side-nav{display:flex;overflow-x:auto;gap:5px}.nav-link{min-height:34px;padding:6px 9px;white-space:nowrap}.nav-link.active{box-shadow:inset 0 -2px #e879a3,inset 0 0 transparent}.nav-icon{display:none}.main-panel{margin-left:0}.topbar{height:50px;padding:0 18px}.online{display:none}.page-container{padding:27px 17px;gap:27px}.row-one,.page-container .row-two,.row-three{grid-template-columns:1fr}.section-heading{align-items:flex-start}.route-pill{font-size:10px}.page-container .contactCard{flex-direction:column;align-items:flex-start}.app-footer{padding:0 17px 18px}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
